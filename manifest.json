{
  "manifest_version": 3,
  "name": "YouTube Click Highlighter",
  "version": "1.0",
  "description": "Clique nas palavras das legendas para destacar com cores.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["analytics.html", "analytics.js", "chart.min.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
